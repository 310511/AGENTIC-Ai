# ============================================================
# AI Agent Platform — Environment Variables (EXAMPLE)
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── PostgreSQL ────────────────────────────────────────────────
# Local: brew install postgresql@16 && brew services start postgresql@16
# Then: createdb agent_platform && psql agent_platform < infra/postgres/init/01_schema.sql
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/agent_platform

# ── Redis ─────────────────────────────────────────────────────
# Local: brew install redis && brew services start redis
REDIS_URL=redis://localhost:6379/0

# ── Neo4j ─────────────────────────────────────────────────────
# Local: brew install neo4j && brew services start neo4j  (Phase 4, not needed yet)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── RabbitMQ ──────────────────────────────────────────────────
# Local: brew install rabbitmq && brew services start rabbitmq  (Phase 6, not needed yet)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ── API Service ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
# Comma-separated list of allowed CORS origins
API_CORS_ORIGINS=http://localhost:3000

# ── LLM Gateway / Ollama ──────────────────────────────────────
# Local: download from https://ollama.com, then: ollama pull llama3.2
# Ollama runs as a native macOS service on port 11434.
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama3.2
LLM_TIMEOUT=120

# ── Orchestrator ──────────────────────────────────────────────
ORCHESTRATOR_URL=http://localhost:8001

# ── Observability ─────────────────────────────────────────────
# Optional for local dev — OTel export failure won't crash the app.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-agent-api

# ── Auth / RBAC ───────────────────────────────────────────────
# Default roles: admin, operator, user
DEFAULT_ADMIN_EMAIL=admin@example.com
